<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Production">
        <PackageVersion Include="AlamoEngineTools.Modinfo" Version="8.0.6"/>
        <!-- Pinned to the version PG.StarWarsGame.Localisation uses, so the editor's own CSV reads
             cannot diverge from the importers the rest of the server shares with it. -->
        <PackageVersion Include="CsvHelper" Version="33.0.1"/>
        <PackageVersion Include="HtmlAgilityPack" Version="1.12.4"/>
        <PackageVersion Include="JsonSchema.Net" Version="9.4.0"/>
        <PackageVersion Include="Loretta.CodeAnalysis.Lua" Version="0.2.13"/>
        <PackageVersion Include="MessagePack" Version="3.1.8"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10"/>
        <PackageVersion Include="OmniSharp.Extensions.LanguageClient" Version="0.19.9"/>
        <PackageVersion Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9"/>
        <PackageVersion Include="Semver" Version="3.0.0"/>
        <PackageVersion Include="Serilog" Version="4.4.0"/>
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0"/>
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageVersion Include="System.CommandLine" Version="2.0.10"/>
        <PackageVersion Include="System.IO.Abstractions" Version="22.2.0"/>
        <PackageVersion Include="Testably.Abstractions.FileSystem.Interface" Version="10.3.0"/>
        <PackageVersion Include="YamlDotNet" Version="18.1.0"/>
    </ItemGroup>

    <ItemGroup Label="Test infrastructure">
        <PackageVersion Include="coverlet.collector" Version="10.0.1"/>
        <PackageVersion Include="coverlet.msbuild" Version="10.0.1"/>
        <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1"/>
        <PackageVersion Include="Microsoft.Testing.Platform" Version="2.3.3"/>
        <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2"/>
    </ItemGroup>

</Project>
