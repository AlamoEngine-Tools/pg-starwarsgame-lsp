{
  "name": "aet-eaw-edit",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "author": {
    "name": "Lukas Grünwald"
  },
  "publisher": "AlamoEngineTools",
  "version": "0.4.1",
  "preview": true,
  "keywords": [
    "star wars",
    "empire at war",
    "forces of corruption",
    "eaw",
    "foc",
    "modding",
    "alamo engine",
    "petroglyph",
    "xml",
    "lua",
    "lsp"
  ],
  "icon": "resources/icons/alamo-engine-tools.png",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:lua",
    "onDebugResolve:eaw-lua",
    "workspaceContains:**/*.pgproj"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "jsonc",
        "extensions": [
          ".pgproj"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.pgproj",
        "url": "./resources/pgproj.schema.json"
      }
    ],
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "eaw-lua",
        "label": "%debugger.eaw-lua.label%",
        "languages": [
          "lua"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "%debugger.eaw-lua.attach.host.description%"
              },
              "port": {
                "type": "number",
                "default": 1234,
                "description": "%debugger.eaw-lua.attach.port.description%"
              },
              "sourceRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%debugger.eaw-lua.attach.sourceRoots.description%"
              },
              "clientName": {
                "type": "string",
                "description": "%debugger.eaw-lua.attach.clientName.description%"
              },
              "unsafeTableExpansion": {
                "type": "boolean",
                "default": false,
                "description": "%debugger.eaw-lua.attach.unsafeTableExpansion.description%"
              },
              "dropDuplicateOutermostFrame": {
                "type": "boolean",
                "default": true,
                "description": "%debugger.eaw-lua.attach.dropDuplicateOutermostFrame.description%"
              }
            }
          },
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.eaw-lua.launch.program.description%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%debugger.eaw-lua.launch.args.description%"
              },
              "cwd": {
                "type": "string",
                "description": "%debugger.eaw-lua.launch.cwd.description%"
              },
              "modPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%debugger.eaw-lua.launch.modPaths.description%"
              },
              "attachTimeoutSeconds": {
                "type": "number",
                "default": 60,
                "description": "%debugger.eaw-lua.launch.attachTimeoutSeconds.description%"
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "%debugger.eaw-lua.launch.host.description%"
              },
              "port": {
                "type": "number",
                "default": 1234,
                "description": "%debugger.eaw-lua.launch.port.description%"
              },
              "sourceRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%debugger.eaw-lua.launch.sourceRoots.description%"
              },
              "clientName": {
                "type": "string",
                "description": "%debugger.eaw-lua.launch.clientName.description%"
              },
              "unsafeTableExpansion": {
                "type": "boolean",
                "default": false,
                "description": "%debugger.eaw-lua.launch.unsafeTableExpansion.description%"
              },
              "dropDuplicateOutermostFrame": {
                "type": "boolean",
                "default": true,
                "description": "%debugger.eaw-lua.launch.dropDuplicateOutermostFrame.description%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "eaw-lua",
            "request": "attach",
            "name": "%debugger.eaw-lua.initial.attach.name%"
          },
          {
            "type": "eaw-lua",
            "request": "launch",
            "name": "%debugger.eaw-lua.initial.launch.name%",
            "program": "${config:aet-eaw-edit.game.executable}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.eaw-lua.snippet.attach.label%",
            "description": "%debugger.eaw-lua.snippet.attach.description%",
            "body": {
              "type": "eaw-lua",
              "request": "attach",
              "name": "%debugger.eaw-lua.snippet.attach.name%"
            }
          },
          {
            "label": "%debugger.eaw-lua.snippet.launch.label%",
            "description": "%debugger.eaw-lua.snippet.launch.description%",
            "body": {
              "type": "eaw-lua",
              "request": "launch",
              "name": "%debugger.eaw-lua.snippet.launch.name%",
              "program": "^\"\\${config:aet-eaw-edit.game.executable}\""
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aet-eaw-edit",
          "title": "%viewsContainer.title%",
          "icon": "resources/icons/alamo-engine-tools.png"
        }
      ]
    },
    "views": {
      "aet-eaw-edit": [
        {
          "id": "aet-eaw-edit.lsp.localisationNavigator",
          "name": "%view.lsp.localisationNavigator.name%",
          "icon": "resources/icons/language-solid-full.svg",
          "when": "config.aet-eaw-edit.features.tools.localisation"
        },
        {
          "id": "aet-eaw-edit.lsp.storyNavigator",
          "name": "%view.lsp.storyNavigator.name%",
          "icon": "resources/icons/book-journal-whills-solid-full.svg",
          "when": "config.aet-eaw-edit.features.tools.storyEditor && config.aet-eaw-edit.features.story.discovery"
        },
        {
          "id": "aet-eaw-edit.lsp.modBrowser",
          "name": "%view.lsp.modBrowser.name%",
          "icon": "$(list-tree)",
          "when": "config.aet-eaw-edit.features.tools.modBrowser"
        }
      ],
      "debug": [
        {
          "id": "aet-eaw-edit.luaDebug.scripts",
          "name": "%view.luaDebug.scripts.name%",
          "icon": "$(file-code)",
          "contextualTitle": "%view.luaDebug.scripts.contextualTitle%",
          "when": "config.aet-eaw-edit.features.lua.debugger"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aet-eaw-edit.lsp.openStoryFile",
          "when": "false"
        },
        {
          "command": "aet-eaw-edit.lsp.openStoryFileUnavailable",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "aet-eaw-edit.lsp.previewCreditsCrawl",
          "when": "activeWebviewPanelId == aetCreditsEditor",
          "group": "navigation@1"
        },
        {
          "command": "aet-eaw-edit.lsp.previewCreditsCrawlFullScreen",
          "when": "activeWebviewPanelId == aetCreditsEditor",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "aet-eaw-edit.luaDebug.refreshScripts",
          "when": "view == aet-eaw-edit.luaDebug.scripts",
          "group": "navigation"
        },
        {
          "command": "aet-eaw-edit.lsp.refreshStoryNavigator",
          "when": "view == aet-eaw-edit.lsp.storyNavigator",
          "group": "navigation"
        },
        {
          "command": "aet-eaw-edit.lsp.newLocalisationProject",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator",
          "group": "navigation"
        },
        {
          "command": "aet-eaw-edit.lsp.setLocalisationProjectFormat",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator",
          "group": "navigation"
        },
        {
          "command": "aet-eaw-edit.lsp.refreshLocalisationNavigator",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aet-eaw-edit.luaDebug.breakScript",
          "when": "view == aet-eaw-edit.luaDebug.scripts && viewItem == aetLuaScript",
          "group": "inline@1"
        },
        {
          "command": "aet-eaw-edit.luaDebug.refreshThreads",
          "when": "view == aet-eaw-edit.luaDebug.scripts && viewItem == aetLuaScript",
          "group": "inline@2"
        },
        {
          "command": "aet-eaw-edit.luaDebug.breakThread",
          "when": "view == aet-eaw-edit.luaDebug.scripts && viewItem == aetLuaThread",
          "group": "inline"
        },
        {
          "command": "aet-eaw-edit.lsp.openStoryGraph",
          "when": "view == aet-eaw-edit.lsp.storyNavigator && viewItem == aetStoryFaction",
          "group": "inline"
        },
        {
          "command": "aet-eaw-edit.lsp.openStoryGraph",
          "when": "view == aet-eaw-edit.lsp.storyNavigator && viewItem == aetStoryBattle",
          "group": "inline"
        },
        {
          "command": "aet-eaw-edit.lsp.openStoryFile",
          "when": "view == aet-eaw-edit.lsp.storyNavigator && viewItem =~ /^aetStory(Campaign|File)$/",
          "group": "inline"
        },
        {
          "command": "aet-eaw-edit.lsp.openStoryFileUnavailable",
          "when": "view == aet-eaw-edit.lsp.storyNavigator && viewItem =~ /^aetStory(CampaignNoFile|FileMissing)$/",
          "group": "inline"
        },
        {
          "command": "aet-eaw-edit.lsp.openLocalisationEditor",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator && viewItem =~ /^aetLocFile/",
          "group": "inline"
        },
        {
          "command": "aet-eaw-edit.lsp.openLocalisationAsText",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator && viewItem =~ /^aetLocFile/",
          "group": "aetLoc@1"
        },
        {
          "command": "aet-eaw-edit.lsp.exportLocalisationToDat",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator && viewItem =~ /^aetLocFile/",
          "group": "aetLoc@2"
        },
        {
          "command": "aet-eaw-edit.lsp.convertLocalisationFormat",
          "when": "view == aet-eaw-edit.lsp.localisationNavigator && viewItem =~ /^aetLocFile/",
          "group": "aetLoc@3"
        }
      ]
    },
    "commands": [
      {
        "command": "aet-eaw-edit.luaDebug.refreshScripts",
        "title": "%command.luaDebug.refreshScripts.title%",
        "icon": "$(refresh)",
        "enablement": "config.aet-eaw-edit.features.lua.debugger && aet-eaw-edit.luaDebug.sessionActive"
      },
      {
        "command": "aet-eaw-edit.luaDebug.refreshThreads",
        "title": "%command.luaDebug.refreshThreads.title%",
        "icon": "$(list-tree)",
        "enablement": "aet-eaw-edit.luaDebug.sessionActive"
      },
      {
        "command": "aet-eaw-edit.luaDebug.breakScript",
        "title": "%command.luaDebug.breakScript.title%",
        "icon": "$(debug-pause)",
        "enablement": "aet-eaw-edit.luaDebug.sessionActive && aet-eaw-edit.luaDebug.canBreak"
      },
      {
        "command": "aet-eaw-edit.luaDebug.breakThread",
        "title": "%command.luaDebug.breakThread.title%",
        "icon": "$(debug-pause)",
        "enablement": "aet-eaw-edit.luaDebug.sessionActive && aet-eaw-edit.luaDebug.canBreak"
      },
      {
        "command": "aet-eaw-edit.lsp.debug.forceStartup",
        "title": "%command.lsp.debug.forceStartup.title%",
        "when": "inDebugMode"
      },
      {
        "command": "aet-eaw-edit.lsp.restartServer",
        "title": "%command.lsp.restartServer.title%"
      },
      {
        "command": "aet-eaw-edit.lsp.revalidateWorkspace",
        "title": "%command.lsp.revalidateWorkspace.title%"
      },
      {
        "command": "aet-eaw-edit.lsp.newModProject",
        "title": "%command.lsp.newModProject.title%"
      },
      {
        "command": "aet-eaw-edit.lsp.reloadProject",
        "title": "%command.lsp.reloadProject.title%"
      },
      {
        "command": "aet-eaw-edit.lsp.selectProject",
        "title": "%command.lsp.selectProject.title%"
      },
      {
        "command": "aet-eaw-edit.lsp.initLocalisationProject",
        "title": "%command.lsp.initLocalisationProject.title%",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.importLocalisationProject",
        "title": "%command.lsp.importLocalisationProject.title%",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.showEffectiveObject",
        "title": "%command.lsp.showEffectiveObject.title%",
        "enablement": "config.aet-eaw-edit.features.tools.variants"
      },
      {
        "command": "aet-eaw-edit.lsp.showEncyclopedia",
        "title": "%command.lsp.showEncyclopedia.title%",
        "enablement": "config.aet-eaw-edit.features.tools.encyclopedia"
      },
      {
        "command": "aet-eaw-edit.lsp.openModBrowser",
        "title": "%command.lsp.openModBrowser.title%",
        "enablement": "config.aet-eaw-edit.features.tools.modBrowser"
      },
      {
        "command": "aet-eaw-edit.lsp.openStoryGraph",
        "title": "%command.lsp.openStoryGraph.title%",
        "icon": "$(type-hierarchy)",
        "enablement": "config.aet-eaw-edit.features.tools.storyEditor && config.aet-eaw-edit.features.story.discovery"
      },
      {
        "command": "aet-eaw-edit.lsp.openStoryFile",
        "title": "%command.lsp.openStoryFile.title%",
        "icon": "$(go-to-file)",
        "enablement": "config.aet-eaw-edit.features.tools.storyEditor && config.aet-eaw-edit.features.story.discovery"
      },
      {
        "command": "aet-eaw-edit.lsp.openStoryFileUnavailable",
        "title": "%command.lsp.openStoryFileUnavailable.title%",
        "icon": "$(go-to-file)",
        "enablement": "false"
      },
      {
        "command": "aet-eaw-edit.lsp.refreshStoryNavigator",
        "title": "%command.lsp.refreshStoryNavigator.title%",
        "icon": "$(refresh)",
        "enablement": "config.aet-eaw-edit.features.tools.storyEditor && config.aet-eaw-edit.features.story.discovery"
      },
      {
        "command": "aet-eaw-edit.lsp.openLocalisationEditor",
        "title": "%command.lsp.openLocalisationEditor.title%",
        "icon": "$(table)",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.refreshLocalisationNavigator",
        "title": "%command.lsp.refreshLocalisationNavigator.title%",
        "icon": "$(refresh)",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.newLocalisationProject",
        "title": "%command.lsp.newLocalisationProject.title%",
        "icon": "$(new-file)",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.exportLocalisationToDat",
        "title": "%command.lsp.exportLocalisationToDat.title%",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.convertLocalisationFormat",
        "title": "%command.lsp.convertLocalisationFormat.title%",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.setLocalisationProjectFormat",
        "title": "%command.lsp.setLocalisationProjectFormat.title%",
        "icon": "$(symbol-file)",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.openLocalisationAsText",
        "title": "%command.lsp.openLocalisationAsText.title%",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.previewCreditsCrawl",
        "title": "%command.lsp.previewCreditsCrawl.title%",
        "icon": "$(open-preview)",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.lsp.previewCreditsCrawlFullScreen",
        "title": "%command.lsp.previewCreditsCrawlFullScreen.title%",
        "icon": "$(screen-full)",
        "enablement": "config.aet-eaw-edit.features.tools.localisation"
      },
      {
        "command": "aet-eaw-edit.copyBugReportInfo",
        "title": "%command.copyBugReportInfo.title%"
      },
      {
        "command": "aet-eaw-edit.lsp.previewModel",
        "title": "%command.lsp.previewModel.title%",
        "enablement": "config.aet-eaw-edit.features.tools.modelPreview"
      },
      {
        "command": "aet-eaw-edit.lsp.previewAssembledUnit",
        "title": "%command.lsp.previewAssembledUnit.title%",
        "enablement": "config.aet-eaw-edit.features.tools.modelPreview"
      },
      {
        "command": "aet-eaw-edit.shaders.obtain",
        "title": "%command.shaders.obtain.title%",
        "enablement": "config.aet-eaw-edit.features.tools.modelPreview"
      }
    ],
    "configuration": [
      {
        "title": "%config.section.general.title%",
        "type": "object",
        "properties": {
          "aet-eaw-edit.lsp.enabled": {
            "order": 100,
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.lsp.enabled.markdownDescription%"
          },
          "aet-eaw-edit.lsp.executable": {
            "order": 200,
            "type": "string",
            "default": "",
            "format": "uri-reference",
            "markdownDescription": "%config.lsp.executable.markdownDescription%",
            "scope": "machine-overridable"
          },
          "aet-eaw-edit.lua.analyzerPath": {
            "order": 210,
            "type": "string",
            "default": "",
            "format": "uri-reference",
            "markdownDescription": "%config.lua.analyzerPath.markdownDescription%",
            "scope": "machine-overridable"
          },
          "aet-eaw-edit.diagnostics.workspaceOnStartup": {
            "order": 390,
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.diagnostics.workspaceOnStartup.markdownDescription%"
          },
          "aet-eaw-edit.encyclopedia.screenWidth": {
            "order": 392,
            "type": "number",
            "default": 1920,
            "minimum": 320,
            "markdownDescription": "%config.encyclopedia.screenWidth.markdownDescription%"
          },
          "aet-eaw-edit.encyclopedia.screenHeight": {
            "order": 393,
            "type": "number",
            "default": 1080,
            "minimum": 240,
            "markdownDescription": "%config.encyclopedia.screenHeight.markdownDescription%"
          },
          "aet-eaw-edit.lsp.locale": {
            "order": 400,
            "type": "string",
            "default": "en",
            "markdownDescription": "%config.lsp.locale.markdownDescription%",
            "enum": [
              "en",
              "de",
              "fr",
              "es",
              "it",
              "pl",
              "ru"
            ],
            "enumItemLabels": [
              "%config.lsp.locale.enumItemLabels.0%",
              "%config.lsp.locale.enumItemLabels.1%",
              "%config.lsp.locale.enumItemLabels.2%",
              "%config.lsp.locale.enumItemLabels.3%",
              "%config.lsp.locale.enumItemLabels.4%",
              "%config.lsp.locale.enumItemLabels.5%",
              "%config.lsp.locale.enumItemLabels.6%"
            ]
          },
          "aet-eaw-edit.lsp.localisation.language": {
            "order": 450,
            "type": "string",
            "default": "ENGLISH",
            "markdownDescription": "%config.lsp.localisation.language.markdownDescription%",
            "enum": [
              "ENGLISH",
              "GERMAN",
              "FRENCH",
              "SPANISH",
              "ITALIAN",
              "POLISH",
              "RUSSIAN",
              "CHINESE",
              "JAPANESE",
              "KOREAN",
              "THAI"
            ],
            "enumItemLabels": [
              "%config.lsp.localisation.language.enumItemLabels.0%",
              "%config.lsp.localisation.language.enumItemLabels.1%",
              "%config.lsp.localisation.language.enumItemLabels.2%",
              "%config.lsp.localisation.language.enumItemLabels.3%",
              "%config.lsp.localisation.language.enumItemLabels.4%",
              "%config.lsp.localisation.language.enumItemLabels.5%",
              "%config.lsp.localisation.language.enumItemLabels.6%",
              "%config.lsp.localisation.language.enumItemLabels.7%",
              "%config.lsp.localisation.language.enumItemLabels.8%",
              "%config.lsp.localisation.language.enumItemLabels.9%",
              "%config.lsp.localisation.language.enumItemLabels.10%"
            ]
          },
          "aet-eaw-edit.lsp.source.baseline.type": {
            "order": 600,
            "type": "string",
            "default": "http",
            "markdownDescription": "%config.lsp.source.baseline.type.markdownDescription%",
            "enum": [
              "http",
              "local"
            ],
            "enumItemLabels": [
              "%config.lsp.source.baseline.type.enumItemLabels.0%",
              "%config.lsp.source.baseline.type.enumItemLabels.1%"
            ]
          },
          "aet-eaw-edit.lsp.source.baseline.localPath": {
            "order": 700,
            "type": "string",
            "default": "",
            "format": "uri-reference",
            "markdownDescription": "%config.lsp.source.baseline.localPath.markdownDescription%",
            "scope": "machine-overridable"
          },
          "aet-eaw-edit.lsp.source.baseline.url": {
            "order": 750,
            "type": "string",
            "default": "",
            "format": "uri-reference",
            "markdownDescription": "%config.lsp.source.baseline.url.markdownDescription%"
          },
          "aet-eaw-edit.lsp.schema.source": {
            "order": 800,
            "type": "string",
            "default": "http",
            "markdownDescription": "%config.lsp.schema.source.markdownDescription%",
            "enum": [
              "http",
              "local"
            ],
            "enumItemLabels": [
              "%config.lsp.schema.source.enumItemLabels.0%",
              "%config.lsp.schema.source.enumItemLabels.1%"
            ]
          },
          "aet-eaw-edit.lsp.schema.url": {
            "order": 900,
            "type": "string",
            "default": "",
            "format": "uri-reference",
            "markdownDescription": "%config.lsp.schema.url.markdownDescription%"
          },
          "aet-eaw-edit.lsp.schema.localPath": {
            "order": 1000,
            "type": "string",
            "default": "",
