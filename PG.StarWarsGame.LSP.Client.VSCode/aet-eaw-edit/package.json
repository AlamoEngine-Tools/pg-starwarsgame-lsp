  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle -- --production",
    "bundle": "node esbuild.js",
    "compile": "tsc -p ./",
    "check-types": "tsc -p ./ --noEmit && tsc -p ./src/webview --noEmit && tsc -p ./src/webview/tsconfig.test.json --noEmit",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc -p ./ --noEmit --watch",
    "test:unit": "node esbuild.test.js && node --test \"out/test-unit/**/*.test.js\" && node --test \"scripts/**/*.test.js\"",
    "rig:translate": "node scripts/shader-rig/translate.js",
    "rig:glcheck": "node scripts/shader-rig/translate.js > scripts/shader-rig/out/translate.txt && node scripts/shader-rig/glcheck.js",
    "rig:render": "node scripts/shader-rig/render.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "node scripts/lint-styled-css.js && node scripts/lint-ascii-strings.js && node scripts/manifest-strings.js && node scripts/host-strings.js && node scripts/catalogue-texts.js && eslint src && prettier --check \"src/**/*.{ts,tsx}\"",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies"
  },
  "_overridesNote": [
    "serialize-javascript: mocha 11 (via @vscode/test-cli 0.0.15, the LATEST) pulls 6.0.2, which",
    "carries a ReDoS - Dependabot #3 and #4. mocha 12 moved to ^7.1.1, but test-cli has not",
    "followed, and npm's own offer is to DOWNGRADE test-cli to 0.0.11, which is backwards.",
    "Scope is small: this chain is dev-only, CI runs dotnet test alone, and the client's own suite",
    "is node --test - nothing automated runs mocha. Pinned forward rather than left to rot so a",
    "real alert is not buried under a standing one. Drop this entry once test-cli ships mocha 12."
  ],
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
