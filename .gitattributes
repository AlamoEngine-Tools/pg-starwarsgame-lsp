# Treat MessagePack index snapshots as binary - prevents diff noise if teams commit project caches
*.msgpack binary

# bash cannot run a script with CRLF line endings, and both setup scripts read the manifest
*.sh text eol=lf
workspace.deps text eol=lf

# Prettier formats the client's TypeScript with LF (its default); a CRLF checkout would fail its check
PG.StarWarsGame.LSP.Client.VSCode/aet-eaw-edit/src/**/*.ts text eol=lf
PG.StarWarsGame.LSP.Client.VSCode/aet-eaw-edit/src/**/*.tsx text eol=lf
