<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <IsTestable>true</IsTestable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2"/>
        <PackageReference Include="Microsoft.Testing.Platform"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.msbuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="GitHubActionsTestLogger"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="OmniSharp.Extensions.LanguageClient"/>
        <PackageReference Include="OmniSharp.Extensions.DebugAdapter.Client"/>
        <PackageReference Include="System.IO.Abstractions.TestingHelpers"/>
    </ItemGroup>

    <!-- The fake game and the container it needs, shared with the debugger's own tests as linked
         sources: one fake, one set of engine rules, no second copy to drift. -->
    <ItemGroup>
        <Compile Include="..\PG.StarWarsGame.LSP.Lua.Debug.Tests\Session\FakeGameDebugServer.cs"
                 Link="LuaDebug\FakeGameDebugServer.cs"/>
        <Compile Include="..\PG.StarWarsGame.LSP.Lua.Debug.Tests\TestServices.cs" Link="LuaDebug\TestServices.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PG.StarWarsGame.LSP.Server\PG.StarWarsGame.LSP.Server.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
