<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- VSTHRD003: the session awaits its own receive-loop task on disconnect, by design -->
        <!-- VSTHRD103: the state machine is driven synchronously under a lock; its async entry
             actions are not used, so the blocking Fire is the right call -->
        <NoWarn>VSTHRD003;VSTHRD103</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="OmniSharp.Extensions.DebugAdapter.Server"/>
        <PackageReference Include="Stateless"/>
        <!-- The standalone adapter host registers the real file system itself; the server does the same. -->
        <PackageReference Include="System.IO.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PG.StarWarsGame.LSP.Core\PG.StarWarsGame.LSP.Core.csproj"/>
        <ProjectReference Include="..\PG.StarWarsGame.LSP.Lua\PG.StarWarsGame.LSP.Lua.csproj"/>
        <!-- The datagram CRC-32 comes from PG.Commons' hashing service, the same copy the server
             already reaches through the localisation baseline. -->
        <ProjectReference Include="..\..\PetroglyphTools\PG.Commons\PG.Commons\PG.Commons.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PG.StarWarsGame.LSP.Lua.Debug.Tests"/>
    </ItemGroup>

</Project>
